# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.p12

# electron-vite temp config
electron.vite.config.*.mjs

# mock-renderer preview output (build:ui-preview)
ui-preview/

# compiled harness plugins (tsc emit, rebuilt by `npm run build`)
packages/*/lib/
