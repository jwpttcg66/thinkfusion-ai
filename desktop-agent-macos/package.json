{
  "name": "thinkfusion-ai",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "Gather, challenge and synthesize perspectives from multiple AI models and web sources — starting with a web AI page driven as the model channel",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build:agent && electron-vite dev",
    "build:agent": "tsc -p tsconfig.agent.json",
    "build": "electron-vite build && npm run build:agent",
    "preview": "electron-vite preview",
    "build:ui-preview": "VITE_MOCK=1 vite build src/renderer --mode development --outDir ui-preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.agent.json && tsc --noEmit -p tsconfig.renderer.json",
    "build:ax:mac": "bash scripts/build-ax-bridge.sh",
    "clean": "rm -rf out dist resources/ax-bridge",
    "package:mac": "npm run build:ax:mac && npm run build && electron-builder --mac dmg --arm64",
    "test:protocol": "npm run build:agent && node scripts/check-protocol.mjs",
    "install:electron": "node node_modules/electron/install.js && node scripts/rename-dev-app.mjs",
    "predev": "npm run install:electron",
    "prebuild": "npm run install:electron",
    "prepackage:mac": "npm run install:electron",
    "doctor:electron": "node scripts/check-electron.mjs",
    "test:security": "node scripts/check-protocol.mjs",
    "build:adapter": "tsc -p tsconfig.adapter.json",
    "test:adapter": "npm run build:adapter && node --test scripts/check-adapter.mjs",
    "test:state": "npm run build:adapter && node --test scripts/check-state-machine.mjs",
    "test": "npm run test:protocol && npm run test:intent && npm run test:text && npm run test:prompt-policy && npm run test:synthesis && npm run test:runner && npm run test:providers && npm run test:ollama && npm run test:cloud && npm run test:execution && npm run test:collaboration && npm run test:debate && npm run test:judge && npm run test:selectors && npm run test:sources-config && npm run test:identity && npm run test:adapter && npm run test:state",
    "prestart:debug": "node scripts/rename-dev-app.mjs",
    "start:debug": "env -u ELECTRON_RUN_AS_NODE -u NODE_OPTIONS electron . --no-sandbox --disable-gpu --remote-debugging-port=9222",
    "check:layout": "node scripts/check-split.mjs && node scripts/check-app-layout.mjs",
    "check:drag": "node scripts/check-split-drag.mjs",
    "check:new-task": "node scripts/check-new-task.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test:intent": "npm run build:agent && node --test scripts/check-intent.mjs",
    "test:synthesis": "npm run build:agent && node --test scripts/check-synthesis.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test:runner": "npm run build:test && node --test scripts/check-runner.mjs",
    "test:providers": "npm run build:test && node --test scripts/check-providers.mjs",
    "test:ollama": "npm run build:test && node --test scripts/check-ollama.mjs",
    "test:ollama:live": "npm run build:test && node --test scripts/check-ollama-live.mjs",
    "test:cloud": "npm run build:test && node --test scripts/check-cloud.mjs",
    "test:cloud:live": "npm run build:test && node --test scripts/check-cloud-live.mjs",
    "test:execution": "npm run build:test && node --test scripts/check-execution.mjs",
    "test:collaboration": "npm run build:test && node --test scripts/check-collaboration.mjs",
    "test:debate": "npm run build:test && node --test scripts/check-debate.mjs",
    "test:judge": "npm run build:test && node --test scripts/check-judge.mjs",
    "check:conversation": "node scripts/check-conversation.mjs",
    "test:text": "npm run build:test && node --test scripts/check-text.mjs",
    "test:selectors": "npm run build:test && node --test scripts/check-selectors.mjs",
    "test:sources-config": "npm run build:test && node --test scripts/check-sources-config.mjs",
    "test:identity": "npm run build:test && node --test scripts/check-identity.mjs",
    "check:pane": "node scripts/check-page-pane.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "test:prompt-policy": "node --test scripts/check-prompt-policy.mjs"
  },
  "dependencies": {
    "zod": "3.25.76",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.1.0",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "build": {
    "appId": "com.thinkfusion.app",
    "productName": "ThinkFusion",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/ax-bridge",
        "to": "ax-bridge",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
