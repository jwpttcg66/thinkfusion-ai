{
  "name": "thinkfusion-ai",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "Gather, challenge and synthesize perspectives from multiple AI models and web sources — starting with a web AI page driven as the model channel",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build:agent && electron-vite dev",
    "build:agent": "tsc -p tsconfig.agent.json",
    "build": "electron-vite build && npm run build:agent",
    "preview": "electron-vite preview",
    "build:ui-preview": "VITE_MOCK=1 vite build src/renderer --mode development --outDir ui-preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.agent.json && tsc --noEmit -p tsconfig.renderer.json",
    "build:ax:mac": "bash scripts/build-ax-bridge.sh",
    "clean": "rm -rf out dist resources/ax-bridge",
    "package:mac": "npm run build:ax:mac && npm run build && electron-builder --mac dmg --arm64",
    "test:protocol": "npm run build:agent && node scripts/check-protocol.mjs",
    "install:electron": "node node_modules/electron/install.js && node scripts/rename-dev-app.mjs",
    "predev": "npm run install:electron",
    "prebuild": "npm run install:electron",
    "prepackage:mac": "npm run install:electron",
    "doctor:electron": "node scripts/check-electron.mjs",
    "test:security": "npm run build:agent && npm run build:test && node --test scripts/check-security.mjs",
    "build:adapter": "tsc -p tsconfig.adapter.json",
    "test:adapter": "npm run build:adapter && node --test scripts/check-adapter.mjs",
    "test:state": "npm run build:adapter && node --test scripts/check-state-machine.mjs",
    "test:window-state": "npm run build:adapter && node --test scripts/check-window-state.mjs",
    "test:thread-navigation": "npm run build:test && node --test scripts/check-thread-navigation.mjs",
    "test": "npm run test:protocol && npm run test:intent && npm run test:workspace && npm run test:routing-model && npm run test:extract && npm run test:analysis && npm run test:engineering && npm run test:engineering-round && npm run test:engineering-tools && npm run test:engineering-orchestration && npm run test:web-orchestration && npm run test:text && npm run test:markdown && npm run test:prompt-policy && npm run test:synthesis && npm run test:runner && npm run test:trace && npm run test:trace-stats && npm run test:dsh-coverage && npm run test:engineering-capabilities && npm run test:evidence && npm run test:ask-user && npm run test:diagnostics && npm run test:terminal && npm run test:session-search && npm run test:engineering-scenarios && npm run test:schedule && npm run test:progress && npm run test:streaming && npm run test:providers && npm run test:ollama && npm run test:cloud && npm run test:cloud-multi && npm run test:execution && npm run test:collaboration && npm run test:debate && npm run test:debate-lead && npm run test:debate-claims && npm run test:debate-revision && npm run test:debate-graph && npm run test:debate-judge && npm run test:debate-events && npm run test:debate-regression && npm run test:debate-prompts && npm run test:debate-strategies && npm run test:debate-metrics && npm run test:debate-eval && npm run test:judge && npm run test:fusion && npm run test:scenarios && npm run test:selectors && npm run test:sources-config && npm run test:identity && npm run test:page-citations && npm run test:adapter && npm run test:state && npm run test:window-state && npm run test:thread-navigation && npm run test:security && npm run test:plan-review && npm run test:model-route && npm run test:local-tools && npm run test:followup && npm run test:export && npm run test:page-document && npm run test:code-read && npm run test:lsp && npm run test:snapshot && npm run test:verify && npm run test:coding-workflow && npm run test:coding-team && npm run test:embeddings && npm run test:capabilities && npm run test:attachments && npm run test:expertise && npm run test:extended-tools && npm run test:batch2 && npm run test:harness",
    "prestart:debug": "node scripts/rename-dev-app.mjs",
    "start:debug": "env -u ELECTRON_RUN_AS_NODE -u NODE_OPTIONS electron . --no-sandbox --disable-gpu --remote-debugging-port=9222",
    "check:layout": "node scripts/check-split.mjs && node scripts/check-app-layout.mjs",
    "check:drag": "node scripts/check-split-drag.mjs",
    "check:new-task": "node scripts/check-new-task.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test:intent": "npm run build:agent && node --test scripts/check-intent.mjs",
    "test:synthesis": "npm run build:agent && node --test scripts/check-synthesis.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test:runner": "npm run build:test && node --test scripts/check-runner.mjs",
    "test:trace": "npm run build:test && node --test scripts/check-trace.mjs",
    "test:trace-stats": "npm run build:test && node --test scripts/check-trace-stats.mjs",
    "test:dsh-coverage": "npm run build:test && node --test scripts/check-dsh-coverage.mjs",
    "test:evidence": "npm run build:test && node --test scripts/check-evidence.mjs",
    "test:ask-user": "npm run build:test && node --test scripts/check-ask-user.mjs",
    "test:diagnostics": "npm run build:test && node --test scripts/check-diagnostics.mjs",
    "test:terminal": "npm run build:test && node --test --test-force-exit scripts/check-terminal.mjs",
    "test:session-search": "npm run build:test && node --test scripts/check-session-search.mjs",
    "test:engineering-scenarios": "npm run build:test && node --test scripts/check-engineering-scenarios.mjs",
    "test:schedule": "npm run build:test && node --test scripts/check-schedule.mjs",
    "test:progress": "npm run build:test && node --test scripts/check-schedule.mjs scripts/check-progress.mjs",
    "test:streaming": "npm run build:test && node --test scripts/check-streaming.mjs",
    "test:engineering-capabilities": "npm run build:test && node --test scripts/check-engineering-capabilities.mjs",
    "test:providers": "npm run build:test && node --test scripts/check-providers.mjs",
    "test:ollama": "npm run build:test && node --test scripts/check-ollama.mjs",
    "test:ollama:live": "npm run build:test && node --test scripts/check-ollama-live.mjs",
    "test:cloud": "npm run build:test && node --test scripts/check-cloud.mjs",
    "test:cloud:live": "npm run build:test && node --test scripts/check-cloud-live.mjs",
    "test:cloud-multi": "npm run build:test && node --test scripts/check-cloud-multi.mjs",
    "test:execution": "npm run build:test && node --test scripts/check-execution.mjs",
    "test:collaboration": "npm run build:test && node --test scripts/check-collaboration.mjs",
    "test:debate": "npm run build:test && node --test scripts/check-debate.mjs",
    "test:debate-lead": "npm run build:test && node --test scripts/check-debate-lead.mjs",
    "test:debate-claims": "npm run build:test && node --test scripts/check-debate-claims.mjs",
    "test:debate-revision": "npm run build:test && node --test scripts/check-debate-revision.mjs",
    "test:debate-graph": "npm run build:test && node --test scripts/check-debate-graph.mjs",
    "test:judge": "npm run build:test && node --test scripts/check-judge.mjs",
    "test:fusion": "npm run build:test && node --test scripts/check-fusion.mjs",
    "test:scenarios": "npm run build:test && node --test scripts/check-scenarios.mjs",
    "check:conversation": "node scripts/check-conversation.mjs",
    "test:text": "npm run build:test && node --test scripts/check-text.mjs",
    "test:selectors": "npm run build:test && node --test scripts/check-selectors.mjs",
    "test:sources-config": "npm run build:test && node --test scripts/check-sources-config.mjs",
    "test:identity": "npm run build:test && node --test scripts/check-identity.mjs",
    "check:pane": "node scripts/check-page-pane.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "test:prompt-policy": "node --test scripts/check-prompt-policy.mjs",
    "test:debate-judge": "npm run build:test && node --test scripts/check-debate-judge.mjs",
    "test:page-citations": "npm run build:test && node --test scripts/check-page-citations.mjs",
    "test:debate-events": "npm run build:test && node --test scripts/check-debate-events.mjs",
    "test:debate-regression": "npm run build:test && node --test scripts/check-debate-regression.mjs",
    "report:debate-regression": "npm run build:test && TF_REPORT=1 node --test scripts/check-debate-regression.mjs",
    "test:debate-strategies": "npm run build:test && node --test scripts/check-debate-strategies.mjs",
    "test:debate-metrics": "npm run build:test && node --test scripts/check-debate-metrics.mjs",
    "test:debate-eval": "npm run build:test && node --test scripts/check-debate-eval.mjs",
    "report:debate-eval": "npm run build:test && TF_REPORT=1 node --test scripts/check-debate-eval.mjs",
    "test:debate-prompts": "npm run build:test && node --test scripts/check-debate-prompts.mjs",
    "quality:debate": "npm run build:test && TF_REPORT=1 node --test scripts/check-debate-eval.mjs",
    "test:markdown": "npm run build:test && node --test scripts/check-markdown.mjs",
    "test:workspace": "npm run build:agent && npm run build:test && node --test scripts/check-workspace.mjs",
    "test:engineering": "npm run build:test && npm run build:agent && node --test scripts/check-engineering.mjs",
    "test:extract": "npm run build:test && node --test scripts/check-extract.mjs",
    "test:analysis": "npm run build:test && node --test scripts/check-analysis.mjs",
    "test:plan-review": "npm run build:test && node --test scripts/check-plan-review.mjs",
    "test:model-route": "npm run build:agent && node --test scripts/check-model-route.mjs",
    "test:local-tools": "npm run build:agent && node --test scripts/check-local-tools.mjs",
    "test:followup": "npm run build:test && node --test scripts/check-followup.mjs",
    "test:engineering-round": "npm run build:test && node --test scripts/check-engineering-round.mjs",
    "test:engineering-orchestration": "npm run build:test && node --test scripts/check-engineering-orchestration.mjs",
    "test:web-orchestration": "npm run build:test && node --test scripts/check-web-orchestration.mjs",
    "test:export": "npm run build:test && node --test scripts/check-export.mjs",
    "test:page-document": "npm run build:test && node --test scripts/check-page-document.mjs",
    "test:code-read": "npm run build:test && node --test scripts/check-code-read.mjs",
    "test:lsp": "npm run build:test && node --test scripts/check-lsp.mjs",
    "test:snapshot": "npm run build:test && node --test scripts/check-snapshot.mjs",
    "test:verify": "npm run build:test && node --test scripts/check-verify.mjs",
    "test:coding-workflow": "npm run build:test && node --test scripts/check-coding-workflow.mjs",
    "test:coding-team": "npm run build:test && node --test scripts/check-coding-team.mjs",
    "test:embeddings": "npm run build:test && node --test scripts/check-embeddings.mjs",
    "test:capabilities": "npm run build:agent && npm run build:test && node --test scripts/check-capabilities.mjs",
    "test:expertise": "npm run build:test && node --test scripts/check-expertise.mjs",
    "test:extended-tools": "npm run build:agent && node --test scripts/check-extended-tools.mjs",
    "test:batch2": "npm run build:agent && node --test scripts/check-capability-batch2.mjs",
    "test:harness": "npm run build:agent && node --test scripts/check-harness-alignment.mjs",
    "test:attachments": "npm run build:test && node --test scripts/check-attachments.mjs",
    "test:routing-model": "npm run build:test && node --test scripts/check-routing-model.mjs",
    "test:engineering-tools": "npm run build:test && node --test scripts/check-engineering-tools.mjs"
  },
  "dependencies": {
    "docx": "9.15.3",
    "node-pty": "^1.2.0-beta.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.1.0",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "build": {
    "appId": "com.thinkfusion.app",
    "productName": "ThinkFusion",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/ax-bridge",
        "to": "ax-bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/expertise",
        "to": "expertise",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  }
}
